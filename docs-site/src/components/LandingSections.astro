---
/**
 * The home page's designed sections, between the hero (Hero.astro) and the
 * prose notes and closing that follow in index.mdx.
 *
 * Each section opens with a label led by the evidence dot and a serif
 * heading closed by the cut rule. Cards are 8px plates in a 12px tray.
 * Solid means settled or observed; dashed means not yet.
 */
import { Image } from "astro:assets";
import HairlineFigure from "./HairlineFigure.astro";
import SystemMap from "./diagrams/SystemMap.astro";
import walkthroughPoster from "../assets/walkthrough-poster.jpg";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const walkthroughId = "BXYmfvuqTPg";

const stages = [
  {
    figure: "sieve",
    label: "A stack of test sieves; the top one rises clear of the stack",
    title: "Route",
    body: "Ticket tags and labels select a procedure, which sets the checklist, clarification policy, agent, and sandbox template for the case.",
  },
  {
    figure: "query",
    label: "A question mark built as a solid, its dot a loose ball",
    title: "Classify",
    body: "The procedure’s checklist names the facts and files the case needs. Facts found in the ticket are sanitized into evidence, and anything missing becomes a clarification question.",
  },
  {
    figure: "padlock",
    label: "A padlock whose shackle springs open",
    title: "Review or automate",
    body: "Review the sanitized facts, file hashes, agent, and limits, or enable a policy to start when evidence is ready. Freshness is checked again at launch.",
  },
  {
    figure: "terminal",
    label: "A terminal window; lines lift off the screen under the pointer",
    title: "Investigate",
    body: "Each run gets its own disposable gVisor or microVM sandbox with egress denied. A kagent investigator runs the experiments, and TriageLab records every process directly from the sandbox.",
  },
  {
    figure: "format",
    label: "A formatter squaring crooked lines to their indents",
    title: "Report",
    body: "JSON and Markdown reports keep what was observed separate from the model’s hypothesis. A reviewed summary can go back to the ticket with the full evidence trail.",
  },
];

const features = [
  {
    title: "Evidence, not answers",
    body: "Process state, exit codes, and output come straight from the sandbox, never from the model’s say-so. Any explanation of the cause is labeled as a hypothesis.",
    link: { text: "Read the article", href: `${base}/articles/evidence-not-answers/` },
  },
  {
    title: "Sandboxed by default",
    body: "Every run uses a disposable gVisor or microVM sandbox. Egress is denied by default, and watchdogs enforce time and size limits. kagent runs the investigator; Agent Substrate provides the isolation.",
    link: { text: "Architecture", href: `${base}/reference/architecture/` },
  },
  {
    title: "Review by default",
    body: "Review the exact evidence and run settings, or explicitly enable automatic starts. Launch checks prevent outdated plans from starting.",
  },
  {
    title: "Your tracker stays the record",
    body: "Zendesk, GitHub, GitLab, Linear, Bondren, and Jira tickets enter the same workflow through policy-checked sources. The conversation stays in your tracker.",
    link: { text: "Ticket guides", href: `${base}/guides/tickets-zendesk/` },
  },
];
---

<div class="landing not-content">
  <section class="section walkthrough" id="walkthrough">
    <div class="tl-wrap walkthrough-grid">
      <div class="walkthrough-copy" data-reveal>
        <p class="tl-eyebrow">Two-minute walkthrough</p>
        <h2 class="tl-display">From a GitHub issue to a verified fix</h2>
        <p class="tl-lede">
          A customer&rsquo;s GitHub issue blames lock retries for 11 missing
          orders. A ticket procedure starts the investigation, a replay of
          the customer&rsquo;s own data loses the same orders with zero
          retries, adding the order ID to the cursor delivers all 625, and
          the reviewed findings go back to the issue. The customer is
          fiction; the code, the data, and the run are real.
        </p>
        <p class="walkthrough-note">
          Playing loads YouTube&rsquo;s privacy-enhanced player. Nothing is
          requested from YouTube until then.
        </p>
      </div>
      <div class="tray player-tray" data-reveal style="--reveal-delay: 80ms">
        <a
          class="player"
          href={`https://www.youtube.com/watch?v=${walkthroughId}`}
          data-youtube-id={walkthroughId}
          aria-label="Play the TriageLab walkthrough video (2 minutes 8 seconds)"
        >
          <Image
            src={walkthroughPoster}
            alt="TriageLab walkthrough: a GitHub issue, reproduced in a sandbox. The replay output shows 0 lock retries and 11 rows that never reached the sink."
            widths={[640, 960, 1440]}
            sizes="(max-width: 64rem) 100vw, 44rem"
          />
        </a>
      </div>
    </div>
  </section>

  <section class="audience" aria-label="Who TriageLab is for">
    <div class="tl-wrap audience-grid" data-reveal>
      <p class="tl-eyebrow">Who it&rsquo;s for</p>
      <div class="audience-body">
        <p class="audience-lead">
          Platform, SRE, and support engineers who see the same technical
          tickets week after week (timeouts, misconfigurations, failed
          deploys) and want every answer backed by evidence, not just a
          confident reply.
        </p>
        <ul class="chips" role="list">
          <li>On-call &amp; platform teams</li>
          <li>Support engineering</li>
          <li>Small teams on Kubernetes</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="how-a-case-moves">
    <div class="tl-wrap">
      <header class="head" data-reveal>
        <p class="tl-eyebrow">The workflow</p>
        <h2 class="tl-display">How a case moves</h2>
      </header>
      <ol class="tray pipeline" role="list">
        {
          stages.map((stage, index) => (
            <li
              class="card stage"
              data-reveal
              style={`--reveal-delay: ${index * 70}ms`}
            >
              <div class="figure-panel tl-graph">
                <HairlineFigure name={stage.figure} label={stage.label} />
              </div>
              <p class="stage-num">{String(index + 1).padStart(2, "0")}</p>
              <h3>{stage.title}</h3>
              <p class="stage-body">{stage.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="boundary-note" data-reveal>
        No untrusted ticket content reaches the sandbox until a person has
        seen exactly what will run. Once a run starts, upstream isolation and
        egress policy enforce the hard limits, not the prompt.
      </p>
    </div>
  </section>

  <section class="section" id="where-the-work-runs">
    <div class="tl-wrap">
      <header class="head" data-reveal>
        <p class="tl-eyebrow">Under the hood</p>
        <h2 class="tl-display">Where the work runs</h2>
      </header>
      <div data-reveal>
        <SystemMap />
      </div>
    </div>
  </section>

  <section class="section" id="why-triagelab">
    <div class="tl-wrap">
      <header class="head" data-reveal>
        <p class="tl-eyebrow">Why TriageLab</p>
        <h2 class="tl-display">Evidence you can defend</h2>
      </header>
      <div class="features">
        {
          features.map((feature, index) => (
            <article
              class="feature"
              data-reveal
              style={`--reveal-delay: ${index * 70}ms`}
            >
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
              {feature.link && (
                <a class="tl-link" href={feature.link.href}>
                  {feature.link.text}
                </a>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="is-it-for-you">
    <div class="tl-wrap">
      <header class="head" data-reveal>
        <p class="tl-eyebrow">Honest fit</p>
        <h2 class="tl-display">Is it for you?</h2>
      </header>
      <div class="tray fit">
        <div class="card fit-card" data-reveal>
          <h3>A good fit today</h3>
          <ul class="fit-list yes" role="list">
            <li>
              Your small team handles repetitive technical tickets: timeouts,
              misconfigurations, failed deploys.
            </li>
            <li>
              You already run Kubernetes and can dedicate a cluster to
              TriageLab.
            </li>
            <li>
              You want AI help that shows its work, with every claim traced
              to a recorded process.
            </li>
          </ul>
        </div>
        <div class="card fit-card not" data-reveal style="--reveal-delay: 70ms">
          <h3>Not yet</h3>
          <ul class="fit-list no" role="list">
            <li>
              It is an early, single-user pilot, not a production support
              platform.
            </li>
            <li>
              The workflow is general, but only a Python 3.12 timeout
              procedure ships with it. Other kinds of tickets need procedures
              you write.
            </li>
            <li>
              There is no database, operator, or multi-tenant deployment.
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  // The walkthrough is a link to YouTube until it is played; only then does
  // the page load YouTube's privacy-enhanced player in place of the poster.
  for (const link of document.querySelectorAll<HTMLAnchorElement>(
    "a[data-youtube-id]",
  )) {
    link.addEventListener("click", (event) => {
      if (
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      )
        return;
      event.preventDefault();
      const frame = document.createElement("iframe");
      frame.src = `https://www.youtube-nocookie.com/embed/${link.dataset.youtubeId}?autoplay=1&rel=0`;
      frame.title =
        "TriageLab walkthrough: a GitHub issue, reproduced in a sandbox";
      frame.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      frame.allowFullscreen = true;
      frame.referrerPolicy = "strict-origin-when-cross-origin";
      const player = document.createElement("div");
      player.className = link.className;
      // Keep Astro's scoped-style attribute so the player keeps its frame.
      for (const attr of link.attributes) {
        if (attr.name.startsWith("data-astro-cid"))
          player.setAttribute(attr.name, attr.value);
      }
      player.append(frame);
      link.replaceWith(player);
      frame.focus();
    });
  }

  // Scroll reveal: one observer, enter-once, never scroll-linked. The hidden
  // state only exists once this script has marked the page (global.css), so
  // the sections are fully visible without JavaScript.
  const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");
  if (targets.length > 0 && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-in");
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -8% 0px" },
    );
    document.documentElement.classList.add("tl-js");
    for (const target of targets) observer.observe(target);
  }
</script>

<style>
  .landing {
    font-family: var(--tl-font-sans);
    color: var(--tl-ink-1);
  }

  .landing :where(h2, h3, p, ul, ol) {
    margin: 0;
  }

  .section {
    padding-block: var(--tl-section-y);
    scroll-margin-top: var(--sl-nav-height);
  }

  /* --- Section header: label, serif heading, cut rule ------------------ */

  .head {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
    border-bottom: 2px solid var(--tl-ink-1);
    padding-bottom: 1.5rem;
  }

  .landing h3 {
    font-family: var(--tl-font-display);
    font-size: 1.3125rem;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.012em;
    text-wrap: balance;
    color: var(--tl-ink);
  }

  /* --- Trays and cards: 8px plates in a 12px frame ---------------------- */

  .tray {
    display: grid;
    gap: 0.375rem;
    border: 1px solid var(--tl-line-object);
    border-radius: var(--tl-radius-xl);
    padding: 0.375rem;
    background: var(--tl-well);
    list-style: none;
  }

  .card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: var(--tl-radius-lg);
    background: var(--tl-plate);
    box-shadow: var(--shadow-plate);
    transition:
      opacity var(--tl-slow) var(--tl-ease),
      transform var(--tl-slow) var(--tl-ease),
      border-color var(--tl-fast) var(--tl-ease);
  }
  .card:hover {
    border-color: var(--tl-rule-cut);
  }

  /* --- Walkthrough -------------------------------------------------------- */

  .walkthrough {
    padding-top: clamp(1rem, 0.5rem + 2vw, 2.5rem);
  }
  .walkthrough-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .walkthrough-copy {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    min-width: 0;
  }
  .walkthrough-copy .tl-display {
    font-size: clamp(1.75rem, 1.35rem + 1.6vw, 2.5rem);
  }
  .walkthrough-copy .tl-lede {
    font-size: 1.0625rem;
  }
  .walkthrough-note {
    font-family: var(--tl-font-mono);
    font-size: 0.75rem;
    line-height: 1.55;
    color: var(--tl-hinge);
  }

  .player-tray {
    min-width: 0;
  }
  .player {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--tl-radius-lg);
    background-color: var(--tl-plate);
    box-shadow: var(--shadow-plate);
  }
  .player:focus-visible {
    outline: 2px solid var(--tl-accent);
    outline-offset: 4px;
  }
  .player img,
  .player :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .player img {
    object-fit: cover;
    transition: transform var(--tl-slow) var(--tl-ease);
  }
  a.player:hover img {
    transform: scale(1.012);
  }

  @media (min-width: 64rem) {
    .walkthrough-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 3.5rem;
    }
    .walkthrough-copy {
      order: 2;
    }
  }

  /* --- Audience ------------------------------------------------------------ */

  .audience {
    border-block: 1px solid var(--tl-line-object);
    padding-block: clamp(3rem, 2.25rem + 3vw, 5rem);
    background: color-mix(in srgb, var(--tl-plate) 55%, transparent);
  }
  .audience-grid {
    display: grid;
    gap: 1.25rem 3rem;
  }
  .audience-body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .audience-lead {
    max-width: 54rem;
    font-family: var(--tl-font-display);
    font-size: clamp(1.375rem, 1.1rem + 1.15vw, 1.9375rem);
    font-weight: 300;
    line-height: 1.35;
    letter-spacing: -0.015em;
    text-wrap: pretty;
    color: var(--tl-ink);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }
  .chips li {
    border: 1px solid var(--tl-line-frame);
    border-radius: var(--tl-radius-xs);
    padding: 0.25rem 0.625rem;
    background: var(--tl-plate);
    font-family: var(--tl-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--tl-ink-muted);
  }
  @media (min-width: 64rem) {
    .audience-grid {
      grid-template-columns: 12rem minmax(0, 1fr);
      align-items: baseline;
    }
  }

  /* --- Pipeline -------------------------------------------------------------
     Each card subgrids the tray's four rows (figure, number, title, body)
     so a two-line title in one card never pushes its neighbours' copy out
     of line. */

  .pipeline {
    grid-template-columns: minmax(0, 1fr);
  }
  .stage {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    row-gap: 0;
    align-items: start;
  }
  .figure-panel {
    align-self: stretch;
    border-bottom: 1px solid var(--tl-line-object);
    padding: 1.25rem 1.5rem;
    background-color: var(--tl-paper);
  }
  .figure-panel :global(.hairline-figure) {
    --hairline-plate: var(--tl-paper);
    max-width: 9.5rem;
    margin-inline: auto;
  }
  .stage-num {
    padding: 1.375rem 1.375rem 0;
    font-family: var(--tl-font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--tl-accent-press);
  }
  .stage h3 {
    padding: 0.375rem 1.375rem 0;
  }
  .stage-body {
    padding: 0.625rem 1.375rem 1.625rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    text-wrap: pretty;
    color: var(--tl-ink-muted);
  }

  @media (min-width: 40rem) {
    .pipeline {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stage:last-child {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 60rem) {
    .pipeline {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .stage,
    .stage:last-child {
      grid-column: span 2;
    }
    .stage:nth-child(n + 4) {
      grid-column: span 3;
    }
  }
  @media (min-width: 76rem) {
    .pipeline {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .stage,
    .stage:last-child,
    .stage:nth-child(n + 4) {
      grid-column: auto;
    }
  }

  .boundary-note {
    max-width: 45rem;
    margin-top: 2rem;
    border-left: 2px solid var(--tl-ink-1);
    padding-left: 1rem;
    line-height: 1.65;
    text-wrap: pretty;
    color: var(--tl-ink-2);
  }

  /* --- Features: ledger columns parted by hairlines ----------------------- */

  .features {
    display: grid;
    gap: 2.5rem 0;
  }
  .feature {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .feature p {
    line-height: 1.65;
    text-wrap: pretty;
    color: var(--tl-ink-muted);
  }
  .feature .tl-link {
    margin-top: 0.25rem;
  }
  /* From two columns up each feature subgrids three rows (title, body,
     link), so a two-line title never knocks the copy beside it out of line. */
  @media (min-width: 40rem) {
    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .feature {
      display: grid;
      grid-row: span 3;
      grid-template-rows: subgrid;
      align-items: start;
      border-left: 1px solid var(--tl-line-frame);
      padding-inline: 1.75rem;
    }
    .feature:nth-child(odd) {
      border-left: 0;
      padding-left: 0;
    }
  }
  @media (min-width: 68rem) {
    .features {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .feature:nth-child(odd) {
      border-left: 1px solid var(--tl-line-frame);
      padding-left: 1.75rem;
    }
    .feature:first-child {
      border-left: 0;
      padding-left: 0;
    }
    .feature:last-child {
      padding-right: 0;
    }
  }

  /* --- Fit: solid is settled, dashed is not yet ---------------------------- */

  .fit {
    grid-template-columns: minmax(0, 1fr);
  }
  .fit-card {
    padding: clamp(1.5rem, 1.25rem + 1vw, 2.25rem);
  }
  .fit-card.not,
  .fit-card.not:hover {
    border: 1px dashed var(--tl-rule-cut);
    background: transparent;
    box-shadow: none;
  }
  .fit-list {
    display: grid;
    gap: 0.875rem;
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
  }
  .fit-list li {
    position: relative;
    padding-left: 1.625rem;
    line-height: 1.6;
    text-wrap: pretty;
    color: var(--tl-ink-2);
  }
  .fit-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid var(--tl-ink);
    border-radius: 50%;
    background: var(--tl-ink);
  }
  .fit-list.no li {
    color: var(--tl-ink-muted);
  }
  .fit-list.no li::before {
    border: 1px dashed var(--tl-rule-cut);
    background: transparent;
  }
  @media (min-width: 52rem) {
    .fit {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
