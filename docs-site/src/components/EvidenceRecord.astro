---
/**
 * The hero's centerpiece: a recorded run of the bundled example, laid out
 * the way a TriageLab report separates things. What the sandbox observed is
 * solid; what the model concluded is dashed and labelled as a hypothesis.
 *
 * Every line is taken from "A recorded run" in start/example.md. Keep the
 * two in step: this card must never say more than that page does.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const observed = [
  {
    ran: "The replay as the customer configured it",
    exit: 1,
    got: "614 of 625 rows · 0 lock retries",
  },
  {
    ran: "The replay with created_at,id as the cursor",
    exit: 0,
    got: "625 of 625 rows",
  },
  {
    ran: "The replay with page_size 500",
    exit: 1,
    got: "622 of 625 rows · 0 lock retries",
  },
  {
    ran: "A comparison script the investigator wrote",
    exit: 0,
    got: "Each page that lost orders ends inside a group with one timestamp",
  },
];

const hypotheses = [
  {
    verdict: "Supported",
    claim:
      "Paging on created_at alone skips the rest of a timestamp group when a page ends inside it.",
  },
  { verdict: "Rejected", claim: "A lock retry is needed to produce the loss." },
  { verdict: "Rejected", claim: "A larger page size fixes it." },
];
---

<figure class="record">
  <div class="frame tl-brackets">
  <div class="sheet">
    <header class="sheet-head">
      <p class="tl-eyebrow">Recorded run</p>
      <p class="meta">12 Nov 2026 · 94 s · 4 processes</p>
      <p class="title">
        The bundled example: a nightly sync that reports success and loses
        11 orders.
      </p>
    </header>

    <section class="part" aria-label="Observed">
      <p class="part-label">
        <span class="tl-stamp ink">Observed</span>
        collected from the sandbox
      </p>
      <ol class="runs" role="list">
        {
          observed.map((run, index) => (
            <li>
              <span class="n">{index + 1}</span>
              <span class="ran">{run.ran}</span>
              <span class:list={["tl-stamp", run.exit === 0 ? "green" : "red"]}>
                exit {run.exit}
              </span>
              <span class="got">{run.got}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="part hypothesis" aria-label="Hypothesis">
      <p class="part-label">
        <span class="tl-stamp dashed">Hypothesis</span>
        the model&rsquo;s reading, kept apart
      </p>
      <ul class="claims" role="list">
        {
          hypotheses.map((item) => (
            <li class:list={[item.verdict.toLowerCase()]}>
              <span class="verdict">{item.verdict}</span>
              <span class="claim">{item.claim}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
  </div>
  <figcaption>
    A real run, not a mock-up.
    <a class="tl-link" href={`${base}/start/example/`}>Read the full run</a>
  </figcaption>
</figure>

<style>
  .record {
    margin: 0;
  }

  .frame {
    --bracket-gap: 0.875rem;
    margin: 0.875rem;
  }

  .sheet {
    overflow: hidden;
    border-radius: var(--tl-radius-lg);
    background: var(--tl-plate);
    box-shadow: var(--shadow-pop);
    font-family: var(--tl-font-sans);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--tl-ink-1);
  }

  .sheet :where(p, ol, ul) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* --- Head: what this is, closed by the cut rule --------------------- */

  .sheet-head {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.625rem 1rem;
    align-items: center;
    border-bottom: 2px solid var(--tl-ink-1);
    padding: 1.125rem 1.25rem 1rem;
  }
  .meta {
    font-family: var(--tl-font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tl-hinge);
  }
  .title {
    grid-column: 1 / -1;
    font-family: var(--tl-font-display);
    font-size: 1.125rem;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--tl-ink);
  }

  /* --- Parts ---------------------------------------------------------- */

  .part {
    padding: 1rem 1.25rem 1.125rem;
  }
  .part-label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--tl-font-mono);
    font-size: 0.75rem;
    color: var(--tl-ink-muted);
  }

  .runs {
    display: grid;
    margin-top: 0.75rem;
  }
  .runs li {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr) auto;
    column-gap: 0.25rem;
    align-items: baseline;
    border-top: 1px solid var(--tl-line-construction);
    padding-block: 0.5625rem;
  }
  .runs li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .runs li:last-child {
    padding-bottom: 0;
  }
  .n {
    font-family: var(--tl-font-mono);
    font-size: 0.75rem;
    color: var(--tl-hinge);
  }
  .ran {
    font-weight: 500;
    color: var(--tl-ink);
  }
  .got {
    grid-column: 2 / -1;
    margin-top: 0.125rem;
    font-family: var(--tl-font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--tl-ink-muted);
  }

  /* What the model thinks sits on a recessed, dashed part: not evidence. */
  .hypothesis {
    border-top: 1px dashed var(--tl-rule-cut);
    background: color-mix(in srgb, var(--tl-well) 55%, var(--tl-plate));
  }
  .claims {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .claims li {
    display: grid;
    grid-template-columns: 5.75rem minmax(0, 1fr);
    column-gap: 0.5rem;
    align-items: baseline;
  }
  .verdict {
    font-family: var(--tl-font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tl-ink);
  }
  .rejected .verdict,
  .rejected .claim {
    color: var(--tl-ink-muted);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-top: 1.5rem;
    padding-inline: 0.875rem;
    font-size: 0.875rem;
    color: var(--tl-ink-muted);
  }

  @media (max-width: 30rem) {
    .frame {
      --bracket-gap: 0.5rem;
      margin: 0.5rem;
    }
    figcaption {
      padding-inline: 0.5rem;
    }
    .sheet-head {
      grid-template-columns: 1fr;
      gap: 0.375rem;
    }
    .title {
      margin-top: 0.25rem;
    }
    .claims li {
      grid-template-columns: 1fr;
    }
  }
</style>
