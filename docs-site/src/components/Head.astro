---
/**
 * Head: renders Starlight's page head, plus a default social card. Pages
 * that declare their own og:image / twitter:image in frontmatter (see
 * blog/2026-11-13-six-cent-investigations.md) keep theirs; every other
 * page gets the site card rendered from social/triagelab-card.html.
 * Replaces Starlight's bare <Head>.
 */

const site = Astro.site;
const card =
  site &&
  new URL(
    `${import.meta.env.BASE_URL}/social/triagelab-card.png`,
    site,
  ).toString();

const { head } = Astro.locals.starlightRoute;
const hasCard = head.some(
  (item) =>
    item.tag === "meta" &&
    (item.attrs?.property === "og:image" || item.attrs?.name === "twitter:image"),
);

if (card && !hasCard) {
  head.push(
    { tag: "meta", attrs: { property: "og:image", content: card } },
    { tag: "meta", attrs: { property: "og:image:width", content: "2400" } },
    { tag: "meta", attrs: { property: "og:image:height", content: "1260" } },
    {
      tag: "meta",
      attrs: {
        property: "og:image:alt",
        content:
          "TriageLab: evidence-driven technical investigations on Kubernetes.",
      },
    },
    { tag: "meta", attrs: { name: "twitter:image", content: card } },
  );
}
---

{head.map(({ tag: Tag, attrs, content }) => (
	<Tag {...attrs} set:html={content} />
))}
