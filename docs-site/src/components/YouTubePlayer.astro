---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  videoId: string;
  title: string;
  playLabel: string;
  poster: ImageMetadata;
  posterAlt: string;
  sizes: string;
}

const { videoId, title, playLabel, poster, posterAlt, sizes } = Astro.props;
---

<a
  class="player not-content"
  href={`https://www.youtube.com/watch?v=${videoId}`}
  data-youtube-id={videoId}
  data-video-title={title}
  aria-label={playLabel}
>
  <Image src={poster} alt={posterAlt} widths={[640, 960, 1440]} sizes={sizes} />
  {Astro.slots.has("default") && <span class="play-badge" aria-hidden="true"><slot /></span>}
</a>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>(
    "a[data-youtube-id]",
  )) {
    link.addEventListener("click", (event) => {
      if (
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      )
        return;
      event.preventDefault();
      const frame = document.createElement("iframe");
      frame.src = `https://www.youtube-nocookie.com/embed/${link.dataset.youtubeId}?autoplay=1&rel=0`;
      frame.title = link.dataset.videoTitle ?? "YouTube video";
      frame.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      frame.allowFullscreen = true;
      frame.referrerPolicy = "strict-origin-when-cross-origin";
      const player = document.createElement("div");
      player.className = link.className;
      // Keep Astro's scoped-style attribute so the player keeps its frame.
      for (const attr of link.attributes) {
        if (attr.name.startsWith("data-astro-cid"))
          player.setAttribute(attr.name, attr.value);
      }
      player.append(frame);
      link.replaceWith(player);
      frame.focus();
    });
  }
</script>

<style>
  .player {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--tl-radius-lg);
    background-color: var(--tl-plate);
    box-shadow: var(--shadow-plate);
  }
  .player:focus-visible {
    outline: 2px solid var(--tl-accent);
    outline-offset: 4px;
  }
  .player img,
  .player :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .player img {
    object-fit: cover;
    transition: transform var(--tl-slow) var(--tl-ease);
  }
  a.player:hover img {
    transform: scale(1.012);
  }
  .play-badge {
    position: absolute;
    inset: auto auto 1rem 1rem;
    border-radius: var(--tl-radius-lg);
    background: #151922;
    color: #fff;
    padding: 0.5rem 0.875rem;
    font-weight: 600;
  }
</style>
