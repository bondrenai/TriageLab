{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "triagelab",
        "namespace": "kagent"
      },
      "automountServiceAccountToken": false
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "triagelab-tools",
        "namespace": "kagent"
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app.kubernetes.io/component": "controller",
          "app.kubernetes.io/instance": "kagent",
          "app.kubernetes.io/name": "kagent"
        },
        "ports": [
          {
            "name": "mcp",
            "port": 8083,
            "protocol": "TCP",
            "targetPort": 8083
          }
        ]
      }
    },
    {
      "apiVersion": "api.kagent.dev/v1alpha3",
      "kind": "Harness",
      "metadata": {
        "name": "triagelab",
        "namespace": "kagent"
      },
      "spec": {
        "kagent": {},
        "substrate": {
          "workerPoolRef": {
            "name": "kagent-default"
          },
          "snapshotPolicy": {
            "location": "gs://ate-snapshots/triagelab/"
          }
        }
      }
    },
    {
      "apiVersion": "api.kagent.dev/v1alpha3",
      "kind": "ModelConfig",
      "metadata": {
        "name": "triagelab-model",
        "namespace": "kagent"
      },
      "spec": {
        "provider": "OpenAI",
        "model": "gpt-4.1",
        "apiKeySecret": "kagent-openai",
        "apiKeySecretKey": "OPENAI_API_KEY"
      }
    },
    {
      "apiVersion": "api.kagent.dev/v1alpha3",
      "kind": "RemoteMCPServer",
      "metadata": {
        "name": "triagelab-sandbox-api",
        "namespace": "kagent"
      },
      "spec": {
        "description": "Trusted KAgent sandbox APIs; caller identity is propagated",
        "protocol": "STREAMABLE_HTTP",
        "url": "http://triagelab-tools.kagent.svc.cluster.local:8083/mcp",
        "timeout": "30s",
        "sseReadTimeout": "5m0s",
        "tokenPassthrough": true
      }
    },
    {
      "apiVersion": "api.kagent.dev/v1alpha3",
      "kind": "AgentTemplate",
      "metadata": {
        "name": "triagelab-investigator",
        "namespace": "kagent"
      },
      "spec": {
        "description": "Evidence-driven technical issue investigator",
        "modelConfig": {
          "name": "triagelab-model"
        },
        "systemPrompt": "",
        "outputSchema": {},
        "outputSchemaStrict": true,
        "tools": [
          {
            "mcp": {
              "server": {
                "kind": "RemoteMCPServer",
                "name": "triagelab-sandbox-api"
              },
              "tools": [
                "start_sandbox_process",
                "get_sandbox_process",
                "kill_sandbox_process",
                "read_sandbox_outputs",
                "read_sandbox_file",
                "write_sandbox_file"
              ]
            }
          }
        ]
      }
    },
    {
      "apiVersion": "api.kagent.dev/v1alpha3",
      "kind": "Agent",
      "metadata": {
        "name": "triagelab-investigator",
        "namespace": "kagent"
      },
      "spec": {
        "template": {
          "ref": {
            "name": "triagelab-investigator"
          }
        },
        "harnessRef": {
          "name": "triagelab"
        }
      }
    },
    {
      "apiVersion": "api.kagent.dev/v1alpha3",
      "kind": "SandboxTemplate",
      "metadata": {
        "name": "triagelab-python",
        "namespace": "kagent"
      },
      "spec": {
        "workload": {
          "image": "docker.io/library/python@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df"
        },
        "substrate": {
          "workerPoolRef": {
            "name": "kagent-default"
          },
          "snapshotPolicy": {
            "location": "gs://ate-snapshots/triagelab/"
          }
        }
      }
    }
  ]
}
